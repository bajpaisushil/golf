# ALL values are optional. The game works with none of them set.
# Static export inlines NEXT_PUBLIC_* at build time.

# Optional: comma-separated extra STUN servers (free public STUN is built in).
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Optional. Leave unset for the free MVP — the game works on STUN alone.
#
# TURN only matters for the ~5-10% of players behind symmetric NAT (some
# corporate and mobile networks), who cannot form a direct peer connection at
# all. It is a config value, not a server you run: several providers give a free
# tier that is far more than this game needs (Cloudflare Calls TURN, and
# Metered's Open Relay both have free tiers). Setting these three values is the
# ONLY way to fix those users; nothing in the app can work around it.
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional: override the free public Nostr relays used for WebRTC signaling.
# NEXT_PUBLIC_SIGNALING_RELAYS=wss://relay.damus.io,wss://nos.lol
