    "nostr-tools": "^2.10.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.63.0",
